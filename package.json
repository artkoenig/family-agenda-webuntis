{
  "name": "family-agenda-webuntis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The WebUntis Source Type of Family Agenda as a stateless plugin container.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node26 --format=esm --outfile=dist/main.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "pnpm build && node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@family-agenda/plugin-contract": "github:artkoenig/family-agenda#51056ae8303d2c6a9922afbd29bab6cc1258d9f5&path:/packages/plugin-contract",
    "@family-agenda/plugin-kit": "github:artkoenig/family-agenda#51056ae8303d2c6a9922afbd29bab6cc1258d9f5&path:/packages/plugin-kit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
